<section class="mk-actors" style="--mk-card-min: {{cardSize}}px;">
  <header class="mk-actors__toolbar">
    <div class="mk-actors__search-wrap">
      <i class="fas fa-search"></i>
      <input type="search" name="search" value="{{state.search}}" placeholder="{{localize 'MKACTORS.Search'}}" autocomplete="off" data-action="search">
    </div>

    <label class="mk-actors__filter">
      <span>{{localize 'MKACTORS.Type'}}</span>
      <select name="type" data-action="type">
        {{#each types}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </label>

    <div class="mk-actors__toolbar-actions">
      <button type="button" data-action="clear" title="{{localize 'MKACTORS.Clear'}}" aria-label="{{localize 'MKACTORS.Clear'}}">
        <i class="fas fa-eraser"></i>
      </button>

      <button type="button" data-action="refresh" title="{{localize 'MKACTORS.Refresh'}}" aria-label="{{localize 'MKACTORS.Refresh'}}">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>
  </header>

  <div class="mk-actors__body{{#if editor}} has-inspector{{/if}}">
    <aside class="mk-actors__sources" aria-label="{{localize 'MKACTORS.SourcesTree'}}">
      <div class="mk-actors__sources-title">{{localize 'MKACTORS.SourcesTree'}}</div>
      <nav class="mk-actors__source-tree">
        {{#each sourceTree}}
          <button type="button"
                  class="{{#if selected}}is-selected{{/if}}"
                  data-action="source-tree"
                  data-source="{{value}}"
                  style="--mk-tree-depth: {{depth}};"
                  title="{{label}}">
            <i class="{{icon}}"></i>
            <span>{{label}}</span>
            <em>{{count}}</em>
          </button>
        {{/each}}
      </nav>
    </aside>

    <main class="mk-actors__main">
      <div class="mk-actors__summary" aria-live="polite">
        <span class="mk-actors__summary-chip">
          <i class="fas fa-users" aria-hidden="true"></i>
          <span>{{localize 'MKACTORS.Showing'}}</span>
          <strong>{{actors.length}}</strong>
          <span>{{localize 'MKACTORS.Of'}}</span>
          <strong data-role="result-count">{{resultCount}}</strong>
          <span>{{localize 'MKACTORS.ActorsCountLabel'}}</span>
        </span>
        {{#if warnings}}
          <span class="mk-actors__warning">
            <i class="fas fa-triangle-exclamation"></i>
            <strong>{{warnings.length}}</strong>
            <span>{{localize 'MKACTORS.SourceWarnings'}}</span>
          </span>
        {{/if}}
      </div>

      {{#if hasActors}}
        <ol class="mk-actors__grid" data-role="grid">
          {{#each actors}}
            <li class="mk-actors__card{{#if selected}} is-selected{{/if}}"
                draggable="true"
                data-action="drag-actor"
                data-uuid="{{uuid}}"
                data-name="{{name}}"
                {{#if selected}}aria-current="true"{{/if}}
                title="{{localize 'MKACTORS.CardHint'}}">
              <div class="mk-actors__portrait">
                <img src="{{img}}"
                     alt="{{name}}"
                     title="{{localize 'MKACTORS.EditTokenPortrait'}}"
                     aria-label="{{localize 'MKACTORS.EditTokenPortrait'}}: {{name}}"
                     loading="lazy"
                     draggable="false"
                     tabindex="0"
                     role="button"
                     data-action="edit-token-portrait">
              </div>
              <div class="mk-actors__content">
                <h3>{{name}}</h3>
              </div>
              <div class="mk-actors__actions">
                <button type="button"
                        data-action="open-sheet"
                        data-uuid="{{uuid}}"
                        title="{{localize 'MKACTORS.OpenSheet'}}"
                        aria-label="{{localize 'MKACTORS.OpenSheet'}}">
                  <i class="fas fa-up-right-from-square"></i>
                </button>
              </div>
            </li>
          {{/each}}
          {{#if hasMore}}
            <li class="mk-actors__load-more">
              <button type="button" data-action="load-more">
                <i class="fas fa-chevron-down"></i>
                <span>{{localize 'MKACTORS.LoadMore'}}</span>
              </button>
            </li>
          {{/if}}
        </ol>
      {{else}}
        <div class="mk-actors__empty">
          <span class="mk-actors__empty-icon"><i class="fas fa-users-slash"></i></span>
          <p>{{localize 'MKACTORS.NoActors'}}</p>
        </div>
      {{/if}}
    </main>

    {{#if editor}}
      <aside class="mk-actors__inspector" aria-label="{{editor.labels.title}}">
        <form class="mk-actors__inspector-form" data-action="token-editor-form" data-uuid="{{editor.uuid}}">
          <header class="mk-actors__inspector-header">
            <span class="mk-actors__inspector-icon" aria-hidden="true">
              <i class="fas fa-image"></i>
            </span>
            <span class="mk-actors__inspector-heading">
              <small>{{editor.labels.title}}</small>
              <strong title="{{editor.name}}">{{editor.name}}</strong>
            </span>
            <button type="button"
                    data-action="close-token-editor"
                    title="{{editor.labels.close}}"
                    aria-label="{{editor.labels.close}}">
              <i class="fas fa-times"></i>
            </button>
          </header>

          <div class="mk-actors__inspector-scroll">
            <div class="mk-actors__inspector-preview">
              <img src="{{editor.portraitImage}}"
                   alt="{{editor.name}}"
                   data-role="token-editor-preview">
            </div>

            <div class="mk-actors__inspector-section">
              <label for="mk-portrait-img">{{editor.labels.imagePath}}</label>
              <div class="mk-actors-token-editor__row">
                <input id="mk-portrait-img"
                       name="portraitImg"
                       type="text"
                       value="{{editor.portraitImage}}"
                       required>
                <button type="button"
                        class="mk-actors-token-editor__browse"
                        data-action="browse-token-image"
                        title="{{editor.labels.browseImage}}"
                        aria-label="{{editor.labels.browseImage}}">
                  <i class="fas fa-folder-open"></i>
                </button>
              </div>
              <p class="notes">{{editor.labels.imagePathPortraitNote}}</p>
            </div>

            <div class="mk-actors__inspector-section">
              <label>{{editor.labels.dimensionsGridSpaces}}</label>
              <div class="mk-actors-token-editor__dimensions">
                <label>
                  <span>{{editor.labels.width}}</span>
                  <input id="mk-token-width"
                         name="tokenWidth"
                         type="number"
                         min="0.5"
                         step="any"
                         value="{{editor.width}}"
                         required>
                </label>
                <label>
                  <span>{{editor.labels.height}}</span>
                  <input id="mk-token-height"
                         name="tokenHeight"
                         type="number"
                         min="0.5"
                         step="any"
                         value="{{editor.height}}"
                         required>
                </label>
              </div>
              <p class="notes">{{editor.labels.fitModeHeightNote}}</p>
            </div>

            <div class="mk-actors__inspector-section">
              <label for="mk-token-fit">{{editor.labels.imageFitMode}}</label>
              <select id="mk-token-fit" name="tokenFit">
                {{#each editor.fitOptions}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              <p class="notes">{{editor.labels.imageFitModeHint}}</p>
            </div>

            <div class="mk-actors__inspector-section">
              <label>{{editor.labels.anchor}}</label>
              <div class="mk-actors-token-editor__dimensions">
                <label>
                  <span>{{editor.labels.x}}</span>
                  <input id="mk-token-anchor-x"
                         name="tokenAnchorX"
                         type="number"
                         min="0"
                         max="1"
                         step="any"
                         value="{{editor.anchorX}}"
                         required>
                </label>
                <label>
                  <span>{{editor.labels.y}}</span>
                  <input id="mk-token-anchor-y"
                         name="tokenAnchorY"
                         type="number"
                         min="0"
                         max="1"
                         step="any"
                         value="{{editor.anchorY}}"
                         required>
                </label>
              </div>
              <p class="notes">{{editor.labels.anchorHint}}</p>
            </div>

            <div class="mk-actors__inspector-section">
              <label for="mk-token-scale">{{editor.labels.scaleRatio}}</label>
              <div class="mk-actors-token-editor__scale">
                <input id="mk-token-scale-range"
                       type="range"
                       min="0.2"
                       max="3"
                       step="0.05"
                       value="{{editor.scale}}">
                <input id="mk-token-scale"
                       name="tokenScale"
                       type="number"
                       min="0.2"
                       max="3"
                       step="any"
                       value="{{editor.scale}}"
                       required>
              </div>
            </div>
          </div>

          <footer class="mk-actors__inspector-footer">
            <button type="submit">
              <i class="fas fa-check"></i>
              <span>{{editor.labels.apply}}</span>
            </button>
          </footer>
        </form>
      </aside>
    {{/if}}
  </div>
</section>
