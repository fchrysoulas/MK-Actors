<section class="mk-actors" style="--mk-card-min: {{cardSize}}px;">
  <header class="mk-actors__toolbar">
    <div class="mk-actors__search-wrap">
      <i class="fas fa-search"></i>
      <input type="search" name="search" value="{{state.search}}" placeholder="{{localize 'MKACTORS.Search'}}" autocomplete="off" data-action="search">
    </div>

    <label>
      <span>{{localize 'MKACTORS.Type'}}</span>
      <select name="type" data-action="type">
        {{#each types}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </label>

    <label>
      <span>{{localize 'MKACTORS.Source'}}</span>
      <select name="source" data-action="source">
        {{#each sources}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </label>

    <button type="button" data-action="clear" title="{{localize 'MKACTORS.Clear'}}">
      <i class="fas fa-eraser"></i>
    </button>

    <button type="button" data-action="refresh" title="{{localize 'MKACTORS.Refresh'}}">
      <i class="fas fa-sync-alt"></i>
    </button>
  </header>

  <div class="mk-actors__summary">
    <span data-role="result-count">{{actors.length}}</span>
    <span>Actors</span>
    {{#if warnings}}
      <span class="mk-actors__warning"><i class="fas fa-triangle-exclamation"></i> {{warnings.length}} source warnings</span>
    {{/if}}
  </div>

  {{#if hasActors}}
    <ol class="mk-actors__grid" data-role="grid">
      {{#each actors}}
        <li class="mk-actors__card"
            draggable="true"
            data-action="drag-actor"
            data-uuid="{{uuid}}"
            data-name="{{name}}"
            data-type="{{type}}"
            data-source-kind="{{sourceKind}}"
            data-source-id="{{sourceId}}"
            data-search="{{searchText}}"
            title="{{localize 'MKACTORS.DragHint'}}">
          <div class="mk-actors__portrait">
            <img src="{{img}}" alt="{{name}}" loading="lazy" onerror="this.src='icons/svg/mystery-man.svg';">
          </div>
          <div class="mk-actors__content">
            <h3>{{name}}</h3>
            <div class="mk-actors__badges">
              {{#if typeLabel}}<span>{{typeLabel}}</span>{{/if}}
              <span>{{sourceLabel}}</span>
            </div>
          </div>
          <div class="mk-actors__actions">
            <button type="button" data-action="open-sheet" data-uuid="{{uuid}}" title="{{localize 'MKACTORS.OpenSheet'}}">
              <i class="fas fa-up-right-from-square"></i>
            </button>
            <button type="button" data-action="spawn-center" data-uuid="{{uuid}}" title="{{localize 'MKACTORS.SpawnCenter'}}">
              <i class="fas fa-location-crosshairs"></i>
            </button>
          </div>
        </li>
      {{/each}}
    </ol>
  {{else}}
    <div class="mk-actors__empty">
      <i class="fas fa-users-slash"></i>
      <p>{{localize 'MKACTORS.NoActors'}}</p>
    </div>
  {{/if}}
</section>
