<div class="mk-actors-token-editor">
  <div class="form-group">
    <label>{{labels.imagePath}}</label>
    <div class="mk-actors-token-editor__row">
      <input id="mk-portrait-img" name="portraitImg" type="text" value="{{portraitImage}}" required>
      <button type="button" id="mk-browse-portrait" class="mk-actors-token-editor__browse" title="{{labels.browseImage}}" aria-label="{{labels.browseImage}}">
        <i class="fas fa-folder-open"></i>
      </button>
    </div>
    <p class="notes">{{labels.imagePathPortraitNote}}</p>
  </div>

  <div class="form-group">
    <label>{{labels.dimensionsGridSpaces}}</label>
    <div class="mk-actors-token-editor__dimensions">
      <label>
        <span>{{labels.width}}</span>
        <input id="mk-token-width" name="tokenWidth" type="number" min="0.5" step="any" value="{{width}}" required>
      </label>
      <label>
        <span>{{labels.height}}</span>
        <input id="mk-token-height" name="tokenHeight" type="number" min="0.5" step="any" value="{{height}}" required>
      </label>
    </div>
    <p class="notes">{{labels.fitModeHeightNote}}</p>
  </div>

  <div class="form-group">
    <label>{{labels.imageFitMode}}</label>
    <select id="mk-token-fit" name="tokenFit">
      {{#each fitOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
    <p class="notes">{{labels.imageFitModeHint}}</p>
  </div>

  <div class="form-group">
    <label>{{labels.anchor}}</label>
    <div class="mk-actors-token-editor__dimensions">
      <label>
        <span>{{labels.x}}</span>
        <input id="mk-token-anchor-x" name="tokenAnchorX" type="number" min="0" max="1" step="any" value="{{anchorX}}" required>
      </label>
      <label>
        <span>{{labels.y}}</span>
        <input id="mk-token-anchor-y" name="tokenAnchorY" type="number" min="0" max="1" step="any" value="{{anchorY}}" required>
      </label>
    </div>
    <p class="notes">{{labels.anchorHint}}</p>
  </div>

  <div class="form-group">
    <label>{{labels.scaleRatio}}</label>
    <div class="mk-actors-token-editor__scale">
      <input id="mk-token-scale-range" type="range" min="0.2" max="3" step="0.05" value="{{scale}}">
      <input id="mk-token-scale" name="tokenScale" type="number" min="0.2" max="3" step="any" value="{{scale}}" required>
    </div>
  </div>
</div>
